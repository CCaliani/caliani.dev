---
---

<section id="contacto" class="contact">
    <div class="contact-copy">
        <h2>
            <span data-i18n="contact.heading1">¿Hablamos de tu</span>
            <span class="accent" data-i18n="contact.heading2">próximo proyecto?</span>
        </h2>
        <p data-i18n="contact.intro">Estoy siempre abierto a nuevas oportunidades y colaboraciones creativas. Si tienes una idea o simplemente quieres saludar, no dudes en escribirme.</p>

        <ul class="contact-methods">
            <li>
                <span class="contact-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                        <path d="M4 6H20V18H4V6Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                        <path d="M4 8L12 13L20 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                </span>
                <span>ccalferran@caliani.dev</span>
            </li>
            <li>
                <a class="contact-call" href="tel:+34657771471" aria-label="Llamar al +34 657 771 471">
                    <span class="contact-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none">
                            <path d="M22 17.9V21C22 21.6 21.5 22 21 22C11.1 22 2 12.9 2 3C2 2.5 2.4 2 3 2H6.1C6.6 2 7 2.4 7.1 2.8L8.1 7C8.2 7.4 8 7.8 7.7 8L5.8 9.3C7.2 12.1 9.9 14.8 12.7 16.2L14 14.3C14.2 14 14.6 13.8 15 13.9L19.2 14.9C19.6 15 20 15.4 20 15.9V19C20 19.6 20.4 20 21 20C21.6 20 22 19.5 22 18.9V17.9Z" fill="currentColor"></path>
                        </svg>
                    </span>
                    <span>+34 657 771 471</span>
                </a>
            </li>
        </ul>
    </div>

    <form action="https://formspree.io/f/xkoowjqz" method="POST" class="contact-form">
        <input type="hidden" name="_subject" value="Nuevo contacto de caliani.dev" />

        <label for="name" data-i18n="contact.name">Nombre</label>
        <input type="text" id="name" name="name" placeholder="Tu nombre" required />

        <label for="email" data-i18n="contact.email">Correo</label>
        <input type="email" id="email" name="email" placeholder="email@ejemplo.com" required />

        <label for="message" data-i18n="contact.message">Mensaje</label>
        <textarea id="message" name="message" rows="7" placeholder="¿Como puedo ayudarte?" required></textarea>

        <button type="submit" data-i18n="contact.send">Enviar mensaje</button>
    </form>
</section>

<style>

.contact {
    width: min(80vw, 1320px);
    max-width: 90vw;
    margin: auto;
    margin-top: 3rem;
    margin-bottom: 6rem;
    padding: 1.2rem;
    display: grid;
    grid-template-columns: minmax(300px, 1fr) minmax(320px, 0.9fr);
    gap: clamp(1.5rem, 4vw, 4.5rem);
    align-items: start;
    color: var(--text-body);
}

.contact-copy {
    padding: 0.6rem 0;
}

.contact-copy h2 {
    margin: 0;
    display: flex;
    flex-direction: column;
    font-family: var(--font-heading);
    font-size: clamp(1.65rem, 3.8vw, 3rem);
    line-height: 1.02;
    color: var(--text-highlight);
    letter-spacing: -0.02em;
}

.contact-copy .accent {
    color: var(--accent-highlight);
}

.contact-copy p {
    margin: 1.8rem 0 2rem;
    max-width: 35ch;
    font-size: clamp(0.98rem, 1.2vw, 1.2rem);
    line-height: 1.5;
    color: rgba(192, 193, 195, 0.82);
}

.contact-methods {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 1rem;
}

.contact-methods li {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: clamp(1rem, 1.6vw, 1.35rem);
    color: rgba(242, 243, 245, 0.95);
}

.contact-call {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    color: inherit;
    text-decoration: none;
    border-radius: 12px;
}

.contact-call:hover {
    color: #8df2fb;
}

.contact-icon {
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 0.9rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #56e5f2;
    background: linear-gradient(180deg, rgba(44, 45, 53, 0.9), rgba(33, 34, 42, 0.95));
}

.contact-icon svg {
    width: 1.4rem;
    height: 1.4rem;
}

.contact-form {
    background: linear-gradient(180deg, rgba(26, 28, 36, 0.88), rgba(22, 23, 31, 0.92));
    border: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: 12px;
    padding: clamp(1.5rem, 2.5vw, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
}

.contact-form label {
    margin-bottom: 0.1rem;
    color: rgba(192, 193, 195, 0.74);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.82rem;
}

.contact-form input, 
.contact-form textarea {
    margin-bottom: 0.5rem;
    padding: 0.95rem 0.9rem;
    border-radius: 2px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    background-color: rgba(18, 20, 30, 0.74);
    color: var(--text-highlight);
    max-width: 95%;
    min-width: 90%;
    max-height: 300px;
    font-size: 1.05rem;
}

.contact-form input::placeholder,
.contact-form textarea::placeholder {
    color: rgba(140, 149, 167, 0.65);
}


.contact-form input:focus,
.contact-form textarea:focus {
    outline: none;
    border-color: rgba(86, 229, 242, 0.58);
    box-shadow: 0 0 0 1px rgba(86, 229, 242, 0.2);
}


.contact-form button {
    margin-top: 0.7rem;
    background-color: #56e5f2;
    color: #072534;
    border: 1px solid transparent;
    border-radius: 14px;
    padding: 1rem 1rem;
    cursor: pointer;
    font-size: 1.2rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    transition: background-color 0.3s ease, color 0.3s ease;
    width: 100%;
    box-shadow: 0 8px 22px rgba(86, 229, 242, 0.24);
}

.contact-form button:hover {
    background-color: #6fedf8;
}

.contact-form button:active {
    transform: scale(0.98);
}

@media (max-width: 980px) {
    .contact {
        grid-template-columns: 1fr;
        gap: 1.6rem;
        padding: 1rem;
    }

    .contact-copy p {
        max-width: 100%;
    }

    .contact-methods li {
        font-size: clamp(1rem, 4.2vw, 1.35rem);
    }
}
</style>

<script>
    const form = document.querySelector('.contact-form');
    if (form instanceof HTMLFormElement) {
        form.addEventListener('submit', function(event) {
            event.preventDefault(); // Evita el envío por defecto

            const nameInput = document.getElementById('name');
            const subjectInput = form.querySelector('input[name="_subject"]');
            
            if (nameInput && subjectInput && nameInput instanceof HTMLInputElement && subjectInput instanceof HTMLInputElement) {
                subjectInput.value = `Nuevo mensaje de: ${nameInput.value}`;
            }

            const formData = new FormData(form);
            const action = form.action;

            fetch(action, {
                method: 'POST',
                body: formData,
                headers: {
                    'Accept': 'application/json'
                }
            }).then(response => {
                if (response.ok) {
                    alert('Mensaje enviado con éxito.');
                    form.reset();
                } else {
                    return response.json().then(data => {
                        if (data.errors) {
                            alert(data.errors.map((error: any) => error.message).join(", "));
                        } else {
                            alert('Hubo un problema al enviar el mensaje.');
                        }
                    });
                }
            }).catch(error => {
                console.error('Error:', error);
                alert('Hubo un problema y no se pudo enviar el mensaje.');
            });
        });
    }
</script>