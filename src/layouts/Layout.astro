<style is:global>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100dvh;
		overflow-x: hidden;
    background-color: #121214;
    /* font-family: system-ui, sans-serif, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; */
    font-family: var(--font-body);
    justify-content: center;
    scroll-behavior: smooth;
	}



	/* 1. DEFINICIÓN DE LA PALETA (Variables CSS) */
  :root {
    /* Tipografias */
    --font-body: "Inter", "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    --font-heading: "Space Grotesk", "Inter", "Segoe UI", sans-serif;
    --font-button: "Manrope", "Inter", "Segoe UI", sans-serif;

    /* Paleta Base */
    --color-base-1: #4B4C51;
    --color-base-2: #37383C;
    --color-base-3: #28292F;
    --color-base-4: #212227;
    --color-base-5: #5C5D61;
    --color-base-6: #C0C1C3;
    --color-base-7: #2D2E33;
    --color-base-8: #424348;
    --color-base-9: #46474C;
    --color-base-10: #57585D;
    --color-base-11: #0cc0df;

    /* Fondos */
    --bg-main: var(--color-base-4);       /* #212227 */
    --bg-element: var(--color-base-7);    /* #2D2E33 */
    
    /* Bordes y Separadores */
    --border-subtle: var(--color-base-2); /* #37383C */
    --border-active: var(--color-base-1); /* #4B4C51 */

    /* Textos */
    --text-muted: var(--color-base-5);    /* #5C5D61 */
    --text-body: var(--color-base-6);     /* #C0C1C3 */
    --text-highlight: #ffffff;            /* Títulos (Blanco puro o casi puro) */

    /* Acentos */
    --accent: var(--color-base-6);        /* Usamos el gris claro como acento */
    --accent-highlight: var(--color-base-11); /* Color de acento destacado */

    
  }

  h1,
  h2,
  h3,
  h4 {
    font-family: var(--font-heading);
  }

  button,
  .btn {
    font-family: var(--font-button);
    font-weight: 700;
  }


</style>
