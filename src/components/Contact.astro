---
---

<section id="contacto" class="contact">
    <form action="https://formspree.io/f/xkoowjqz" method="POST" class="contact-form">
        <h2 data-i18n="contact.title">Contacto</h2>
        <label for="name" data-i18n="contact.name">Nombre:</label>
        <input type="text" id="name" name="name" required />

        <label for="email" data-i18n="contact.email">Correo Electrónico:</label>
        <input type="email" id="email" name="email" required />

        <label for="message" data-i18n="contact.message">Mensaje:</label>
        <textarea id="message" name="message" rows="7" required></textarea>

        <button type="submit" data-i18n="contact.send">Enviar</button>
    </form>
</section>

<style>

.contact {
    max-width: 700px;
    margin: auto;
    margin-top: 2rem;
    padding: 1rem;
    background-color: var(--bg-element);
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    color: var(--text-body);
}

.contact-form {
    display: flex;
    flex-direction: column;
}

.contact-form h2 {
    color: var(--text-highlight);
    margin-bottom: 1rem;
    margin-top: auto;
}

.contact-form label {
    margin-bottom: 0.5rem;
}

.contact-form input, 
.contact-form textarea {
    margin-bottom: 1rem;
    padding: 0.5rem;
    border-radius: 4px;
    border: none;
    background-color: var(--bg-main); 
    color: var(--text-body);
}



.contact-form button {
    background-color: var(--text-highlight);
    color: var(--bg-main);
    border: 1px solid transparent;
    border-radius: 30px;
    padding: 0.5rem 1rem;
    cursor: pointer;
    font-size: 1rem;
    transition: background-color 0.3s ease, color 0.3s ease;
    max-width: 150px;
}

.contact-form button:hover {
    background-color: var(--bg-main);
    color: var(--text-highlight);
}
.contact-form button:active {
    transform: scale(0.98);
}
</style>

<script>
    const form = document.querySelector('.contact-form');
    if (form instanceof HTMLFormElement) {
        form.addEventListener('submit', function(event) {
            event.preventDefault(); // Evita el envío por defecto

            const formData = new FormData(form);
            const action = form.action;

            fetch(action, {
                method: 'POST',
                body: formData,
                headers: {
                    'Accept': 'application/json'
                }
            }).then(response => {
                if (response.ok) {
                    alert('Mensaje enviado con éxito.');
                    form.reset();
                } else {
                    alert('Hubo un problema al enviar el mensaje.');
                }
            }).catch(error => {
                alert('Hubo un problema al enviar el mensaje.');
            });
        });
    }
</script>