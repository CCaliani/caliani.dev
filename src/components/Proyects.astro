---
import { Icon } from 'astro-icon/components';
---

<section id="proyectos" class="proyects section">
    <h2 data-i18n="projects.title"><Icon name="proyects" height="25" width="25" />Proyectos</h2>
    <div class="projects-list">
    <article class="project-item">
        <img src="/src/assets/images/EjemploGM.png" alt="GamerMatch Preview" />
        <h3>GamerMatch</h3>
        <p data-i18n="projects.gamermatch">Trabajo final del grado superior en desarrollo de aplicaciones web.</p>
        <button id="saber-mas" data-i18n="projects.more">Saber más</button>
        <div id="mas-informacion">
            <p data-i18n="projects.gamermatchMore">GamerMatch es una plataforma web diseñada para conectar a jugadores de videojuegos que buscan compañeros de juego con intereses similares. La aplicación permite a los usuarios crear perfiles, buscar otros jugadores según sus preferencias de juego, y comunicarse a través de un sistema de mensajería integrado. El proyecto fue desarrollado utilizando tecnologías web modernas como HTML5, CSS3, JavaScript y un framework backend para gestionar la base de datos y la lógica del servidor.</p>
        </div>
    </article>
    <article class="project-item">
        <img src="/src/assets/images/Comingsoon.jpg" alt="KeyTariner Preview" />
        <h3>KeyTariner</h3>
        <p data-i18n="projects.keytariner">Aplicación para mejorar la capacidad de mecanografía a través de niveles de dificultad y sistema de puntaje.</p>
                <button id="saber-mas" data-i18n="projects.more">Saber más</button>
    </article>
    <article class="project-item">
        <img src="/src/assets/images/Comingsoon.jpg" alt="Project 3 Preview" />
        <h3>Boda Marta&Carlos</h3>
        <p data-i18n="projects.wedding">Web personal tipo invitación digital de bodas</p>
                <button id="saber-mas" data-i18n="projects.more">Saber más</button>

    </article>
    </div>
</section>

<style> 

.section {
    max-width: 700px;
    margin: auto;
    padding: 1rem;
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
}

.section h2 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.5rem;
    color: var(--text-highlight);
    margin-bottom: 0.5rem;
}

.projects-list {
    max-width: 100%;
    justify-content: space-between;
    display: flex;
    flex-direction: row;
    gap: 0.7rem;
    margin-top: 1rem;
}

article.project-item {
    background-color: var(--color-base-8);
    border-radius: 8px;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-height: 100%;
}

.project-item img {
    width: 100%;
    max-height: 8rem;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-bottom: 1rem;
}

.project-item h3 {
    margin-top:0;
    margin-bottom: 0.2rem;
    color: var(--text-highlight);
}

.project-item p {
    color: var(--text-body);
    text-align: center;
    padding:  0.3rem;
    margin-top: 0;
    margin-bottom: 0.5rem;
    text-align: center;
}

.project-item button {
    margin-top: auto;
    margin-bottom: 1rem;
    background-color: var(--text-highlight);
    color: var(--bg-main);
    border: 1px solid transparent;
    border-radius: 30px;
    padding: 0.5rem 1rem;
    cursor: pointer;
    width: 95%;
    color: var(--bg-main);
    
}

.project-item button:hover {
    background-color: var(--bg-main);
    color: var(--text-highlight);
    transition: background-color 0.3s ease, color 0.3s ease;
}
.project-item button:active {
    transform: scale(0.95);
    transition: transform 0.1s ease;
}



article.project-item:hover {
    transform: translateY(-10px);
    transition: transform 0.3s ease;
}

article.project-item:not(:hover) {
    transform: translateY(0);
    transition: transform 0.3s ease;
}

#mas-informacion {
    display: none;
    padding: 0.5rem;
    color: var(--text-body);
    text-align: justify;
}

/* Responsive Design */
@media (max-width: 620px) {
    .projects-list {
        flex-direction: column;
    }
}

</style>

<script>
// Lógica para mostrar más información al hacer clic en "Saber más"
document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.project-item button');
    
    buttons.forEach(button => {
        button.addEventListener('click', () => {
            const infoDiv = button.nextElementSibling;
            if (infoDiv instanceof HTMLElement && infoDiv.id === 'mas-informacion') {
                if (infoDiv.style.display === 'block') {
                    infoDiv.style.display = 'none';
                    // Revertir texto usando el traductor si es posible, o un simple toggle por ahora
                    // Para una solución robusta con i18n, se necesitaría más lógica, 
                    // pero aquí arreglamos el error de tipo.
                } else {
                    infoDiv.style.display = 'block';
                }
            }
        });
    });
});


</script>