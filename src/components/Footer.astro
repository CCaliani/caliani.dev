    display: flex;
    gap: 2rem;
}

.footer-links a {
    font-size: 0.9rem;
    color: rgba(192, 193, 195, 0.6);
    text-decoration: none;
    transition: color 0.2s ease;
}

.footer-links a:hover {
    color: var(--color-base-11);
}

@media (max-width: 600px) {
    .footer-inner {
        flex-direction: column;
